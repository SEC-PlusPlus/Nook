{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nook",
  "version": "0.7.1",
  "identifier": "dev.nook.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Nook —— 桌角的一枚闲窗",
    "longDescription": "A pocket-sized always-on-top window that keeps Douyin playing in the corner of your desktop — translucent, lockable, Electron-free.",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
